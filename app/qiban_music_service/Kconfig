config LVX_USE_DEMO_CONTEST2026_110_QIBAN_MUSIC_SERVICE
	bool "Qiban music playback service"
	select NETUTILS_NETLIB
	default n
	---help---
		Enable the music playback service for the contest 2026 team 110
		Qiban AI dashboard.  Supports SD card local playback, WiFi
		streaming, and Bluetooth audio.

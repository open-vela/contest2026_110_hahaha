{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openvela.local/schemas/qiban_vehicle_state.schema.json",
  "title": "Qiban Vehicle State",
  "description": "Canonical board-to-UI vehicle state payload for the Qiban AI dashboard MVP.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "generated_at_epoch_s",
    "speed_kmh",
    "battery_percent",
    "remaining_range_km",
    "ride_duration_min",
    "total_distance_km_x10",
    "nav_remaining_m",
    "alerts"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "generated_at_epoch_s": {
      "type": "integer",
      "minimum": 0
    },
    "speed_kmh": {
      "type": "integer",
      "minimum": 0
    },
    "battery_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "remaining_range_km": {
      "type": "integer",
      "minimum": 0
    },
    "ride_duration_min": {
      "type": "integer",
      "minimum": 0
    },
    "total_distance_km_x10": {
      "type": "integer",
      "minimum": 0,
      "description": "Total distance in tenths of a kilometer."
    },
    "nav_remaining_m": {
      "type": "integer",
      "minimum": 0
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overspeed",
        "low_battery",
        "fatigue"
      ],
      "properties": {
        "overspeed": {
          "type": "boolean"
        },
        "low_battery": {
          "type": "boolean"
        },
        "fatigue": {
          "type": "boolean"
        }
      }
    }
  }
}
